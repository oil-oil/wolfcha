ZENMUX_API_KEY=your_zenmux_api_key_here 
TOKENDANCE_API_KEY=your_tokendance_api_key_here
TOKENDANCE_BASE_URL=your_tokendance_base_url_here
# MiniMax API 配置
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here
MINIMAX_API_BASE_URL=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-01-turbo

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_default_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here 

# 多人游戏服务
# 本地开发：Next.js 运行在 3000，常驻 Socket.IO 服务运行在 3001
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:3011
GAME_SERVER_PORT=3011
GAME_SERVER_CORS_ORIGIN=http://localhost:3000
# 可选：覆盖多人模式服务端 AI 模型；留空时按已配置供应商使用内置默认模型
MULTIPLAYER_AI_MODEL=
# 使用 Supabase 房间存储时会自动校验房主已扣费的 game session
GAME_SERVER_REQUIRE_CREDIT=false
# 仅限本地测试；进程退出后房间全部清空，不读写 Supabase 多人表
GAME_SERVER_STORE=supabase
GAME_SERVER_ACTION_TIMEOUT_MS=90000
GAME_SERVER_SPEECH_TIMEOUT_MS=120000
# 后台 AI 推进失败后的重试间隔；真人操作已经落库，不需要重复提交
GAME_SERVER_AI_RETRY_MS=5000
# 单进程模型请求硬上限，避免多个房间同时推进时击穿供应商限流
MULTIPLAYER_AI_MAX_CONCURRENCY=8
MULTIPLAYER_AI_MAX_QUEUE=64
MULTIPLAYER_USAGE_TIMEOUT_MS=1500
# 已结束/关闭/废弃大厅的保留与清扫周期；进行中房间永不清理
GAME_SERVER_HISTORY_RETENTION_DAYS=30
GAME_SERVER_HISTORY_SWEEP_MS=86400000
# 仅限本地浏览器联机测试；两项必须同时开启，生产环境服务端仍强制禁用
GAME_SERVER_TEST_AUTH=false
NEXT_PUBLIC_GAME_SERVER_TEST_MODE=false

# Stripe 配置
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID=your_stripe_price_id_here

# 观猹 OAuth2 配置（可选，配置后登录弹窗会显示观猹登录按钮）
NEXT_PUBLIC_WATCHA_CLIENT_ID=your_watcha_client_id_here
WATCHA_CLIENT_SECRET=your_watcha_client_secret_here

NEWAPI_API_KEY=your_newapi_api_key_here
NEWAPI_BASE_URL=your_newapi_url_here
